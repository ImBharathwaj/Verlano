generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  phone           String?
  password        String?   // null for OAuth-only users
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())

  cart                   Cart?
  orders                 Order[]
  addresses              Address[]
  wishlistItems          WishlistItem[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Product {
  id           String          @id @default(uuid())
  title        String
  slug         String          @unique
  description  String
  brand        String
  categories   String[]        @default([]) // e.g. ["women", "shirt"] — used for shop filter
  price        Int
  comparePrice Int?
  createdAt    DateTime        @default(now())

  variants       ProductVariant[]
  images         ProductImage[]
  wishlistItems  WishlistItem[]
}

model ProductVariant {
  id        String    @id @default(uuid())
  product   Product   @relation(fields: [productId], references: [id])
  productId String
  size      String
  color     String?
  sku       String    @unique
  price     Int

  inventory Inventory?
  cartItems CartItem[]
  orderItems OrderItem[]
}

model Inventory {
  id               String         @id @default(uuid())
  variant          ProductVariant @relation(fields: [variantId], references: [id])
  variantId        String         @unique
  stockQuantity    Int
  reservedQuantity Int            @default(0)
}

model Cart {
  id        String     @id @default(uuid())
  user      User?      @relation(fields: [userId], references: [id])
  userId    String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt

  items     CartItem[]
}

model InventoryReservation {
  id        String   @id @default(uuid())
  cartId    String
  variantId String
  quantity  Int
  expiresAt DateTime

  @@unique([cartId, variantId])
}

model CartItem {
  id        String         @id @default(uuid())
  cart      Cart           @relation(fields: [cartId], references: [id])
  cartId    String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  variantId String
  quantity  Int
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  type           String    // percent | fixed
  value          Int       // percent: 1-100, fixed: amount in paise
  minOrderAmount Int?      // minimum order in paise
  maxUses        Int?      // null = unlimited
  usedCount      Int       @default(0)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
}

model Order {
  id            String      @id @default(uuid())
  user          User?       @relation(fields: [userId], references: [id])
  userId        String?
  cartId        String?     // for releasing inventory reservations on payment success
  totalAmount   Int
  couponCode    String?     // applied coupon code
  discountAmount Int       @default(0) // discount in paise
  paymentStatus String      // pending | paid | failed | refunded | cod
  orderStatus   String      // pending | processing | shipped | delivered

  // Guest shipping address (stored on order for guest checkout)
  shippingEmail    String?   // for order lookup / tracking
  shippingName     String?
  shippingPhone    String?
  shippingStreet   String?
  shippingCity     String?
  shippingState    String?
  shippingPostalCode String?

  razorpayOrderId String?   @unique  // for webhook lookup

  // Shipping / tracking
  shippingProvider String?   // e.g. shiprocket
  trackingId       String?   @unique
  trackingUrl      String?
  shippingStatus   String?   // created | picked_up | in_transit | delivered

  createdAt     DateTime    @default(now())

  items         OrderItem[]
  payment       Payment?
}

model OrderItem {
  id        String         @id @default(uuid())
  order     Order          @relation(fields: [orderId], references: [id])
  orderId   String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  variantId String
  quantity  Int
  price     Int
}

model Address {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  name       String
  phone      String
  street     String
  city       String
  state      String
  postalCode String
}

model Payment {
  id              String  @id @default(uuid())
  order           Order   @relation(fields: [orderId], references: [id])
  orderId         String  @unique
  paymentProvider String
  paymentStatus   String
  transactionId   String  @unique
  amount          Int
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  source    String   @default("homepage") // homepage | checkout
  createdAt DateTime @default(now())
}

model ProductImage {
  id        String  @id @default(uuid())
  product   Product @relation(fields: [productId], references: [id])
  productId String
  url       String
  alt       String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String   // order | product
  entityId   String
  action     String   // create | update | delete
  field      String?  // e.g. orderStatus, price
  oldValue   String?  // JSON or string
  newValue   String?  // JSON or string
  createdAt  DateTime @default(now())
}